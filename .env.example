# Base de datos. Opciones:
#  - Render (no instalas nada): la External Database URL + ?sslmode=no-verify al final
#  - Docker (repo sonrisas_cristal_db): la API también va en Docker (docker compose up) y usa
#      postgresql://api_user:<API_DB_PASSWORD>@postgres:5432/sonrisas_cristal
#    "postgres" es el nombre de la base dentro de la red sonrisas_net (no tiene puerto abierto en tu PC).
DATABASE_URL="postgresql://api_user:cambia_esta_clave@postgres:5432/sonrisas_cristal"

JWT_SECRET="cambia-esto-por-un-texto-largo-y-secreto"

TZ="America/Monterrey"

TOLERANCIA_MINUTOS=5

SEED_PASSWORD="Cristal2026"
