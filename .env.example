# Copia este archivo como .env y llena tus valores.

# Base de datos. Opciones:
#  - Render (no instalas nada): la External Database URL + ?sslmode=no-verify al final
#  - Docker (repo sonrisas_cristal_db): postgresql://api_user:<API_DB_PASSWORD>@localhost:5432/sonrisas_cristal
#    (api_user solo puede leer, insertar y actualizar; para `npm run db:crear` usa el usuario postgres)
DATABASE_URL="postgresql://postgres:cambia_esta_clave@localhost:5432/sonrisas_cristal"

# Cualquier texto largo y secreto. En Render va en Environment.
JWT_SECRET="cambia-esto-por-un-texto-largo-y-secreto"

# Zona horaria de las estancias: se usa para saber qué día es "hoy" y calcular retardos.
TZ="America/Monterrey"

# Minutos de gracia antes de contar un retardo.
TOLERANCIA_MINUTOS=5

# Contraseña de todas las cuentas de prueba que crea `npm run seed`
SEED_PASSWORD="Cristal2026"
