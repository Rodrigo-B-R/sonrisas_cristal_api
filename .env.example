# Copy this file as .env and fill in your values. The .env file is never committed.

# ── Database ─────────────────────────────────────────────────────────
# It uses SQLAlchemy's driver: "postgresql+psycopg://" ("postgresql://" is also accepted).
# If the password has special characters (# * ] ! = ^ @ : / ...) it MUST be percent-encoded:
#   python -c "import urllib.parse as u; print(u.quote('your-password', safe=''))"
#
#  - Docker (repo sonrisas_cristal_db), API also in Docker: user api_user, host "postgres"
#    (the name of the database inside the sonrisas_net network; it has no port open on your PC)
#      postgresql+psycopg://api_user:<API_DB_PASSWORD, encoded>@postgres:5432/sonrisas_cristal
#  - API on your PC, database in Docker: use "localhost" and add  ports: ["5432:5432"]  to the
#    postgres service of that repo (temporarily)
#  - Render: the External Database URL, with "postgresql+psycopg://" at the start and
#    "?sslmode=require" at the end
DATABASE_URL="postgresql+psycopg://api_user:change-this-password@postgres:5432/sonrisas_cristal"

# ── Login ────────────────────────────────────────────────────────────
# A long, secret text (at least 32 characters). To generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET="change-this-to-a-long-secret-text"
# Minutes a token lasts. It only says WHO you are: role and daycare are read from the database
# on every request, so changes (termination, transfer, new role) apply immediately.
JWT_EXPIRE_MINUTES=60

# ── Business rules ───────────────────────────────────────────────────
# Time zone of the daycares: decides what "today" is and who is late.
TZ="America/Monterrey"
# Minutes of grace before a clock-in counts as late.
LATE_TOLERANCE_MINUTES=5

# ── Runtime ──────────────────────────────────────────────────────────
# "development" turns on /docs and /redoc. In production use "production" (the Dockerfile already does).
ENVIRONMENT="development"
# Port of your PC when running with docker compose (8000 by default; Grafana uses 3000).
# API_PORT=8000
# Password of every test account created by `python -m scripts.seed` (never use it in production).
SEED_PASSWORD="Cristal2026"

# ── Brute-force protection ───────────────────────────────────────────
# POST /login per client IP, and every other route per IP.
LOGIN_RATE_LIMIT="5/minute"
DEFAULT_RATE_LIMIT="300/minute"
# After this many failed logins on the same username the account is locked for LOGIN_LOCKOUT_MINUTES.
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15
# The API is behind a Cloudflare tunnel: every request arrives from the tunnel container, and the real
# client IP comes in the CF-Connecting-IP header. That header is only believed when the request comes
# from one of these networks (comma-separated CIDRs). Use the subnet of the Docker network:
#   docker network inspect sonrisas_net
# Leave it empty if the API is not behind a proxy. WITHOUT it behind the tunnel, all users would
# share one IP and the login limit would be shared by everybody.
TRUSTED_PROXIES="172.16.0.0/12"

# ── Metrics ──────────────────────────────────────────────────────────
# GET /metrics asks for  Authorization: Bearer <METRICS_TOKEN>  (set the same one in Prometheus).
# If it is empty, /metrics is turned off.
METRICS_TOKEN="change-this-to-another-secret-text"
