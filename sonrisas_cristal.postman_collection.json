  "item": [
    {
      "name": "0. Inicia sesión primero",
      "item": [
        {
          "name": "Login empleada (ana.torres) - guarda el token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login correcto (200)', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('empleada', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clave\": \"ana.torres\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{base}}/login"
          }
        },
        {
          "name": "Login responsable (marisol.garcia) - guarda el token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login correcto (200)', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('responsable', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clave\": \"marisol.garcia\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{base}}/login"
          }
        },
        {
          "name": "Login direccion (direccion) - guarda el token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login correcto (200)', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('direccion', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clave\": \"direccion\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{base}}/login"
          }
        }
      ]
    },
